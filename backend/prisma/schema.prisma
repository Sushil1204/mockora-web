generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  EXPERT
  ADMIN
}

enum RoleStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                String                 @id @default(uuid()) @db.Uuid
  email             String                 @unique @db.VarChar(320)
  passwordHash      String                 @map("password_hash")
  name              String                 @db.VarChar(100)
  avatarUrl         String?                @map("avatar_url")
  countryCode       String?                @map("country_code") @db.VarChar(2)
  preferredLanguage String                 @default("en") @map("preferred_language") @db.VarChar(16)
  emailVerifiedAt   DateTime?              @map("email_verified_at") @db.Timestamptz(3)
  accountStatus     AccountStatus          @default(ACTIVE) @map("account_status")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles             UserRole[]
  sessions          Session[]
  passwordResets    PasswordResetToken[]
  candidateProfile  CandidateProfile?
  expertProfile     ExpertProfile?         @relation("ExpertProfileOwner")
  reviewedExperts   ExpertProfile[]        @relation("ExpertProfileReviewer")
  slotReservations  SlotReservation[]      @relation("CandidateSlotReservations")
  candidateBookings Booking[]              @relation("BookingCandidate")
  bookingChanges    BookingStatusHistory[] @relation("BookingStatusActor")
  notifications     Notification[]

  @@map("users")
}

model UserRole {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      Role
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum CareerStage {
  STUDENT
  FRESHER
  EARLY_CAREER
  MID_CAREER
  SENIOR
  CAREER_SWITCHER
}

enum ProfileCompletionState {
  INCOMPLETE
  COMPLETE
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum PublicationStatus {
  UNPUBLISHED
  PUBLISHED
}

model Industry {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @db.VarChar(120)
  slug            String             @unique @db.VarChar(120)
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobRoles        JobRole[]
  specializations Specialization[]
  candidates      CandidateProfile[] @relation("CandidateIndustry")
  experts         ExpertIndustry[]

  @@map("industries")
}

model JobRole {
  id               String             @id @default(uuid()) @db.Uuid
  industryId       String             @map("industry_id") @db.Uuid
  name             String             @db.VarChar(120)
  slug             String             @db.VarChar(120)
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  industry         Industry           @relation(fields: [industryId], references: [id], onDelete: Cascade)
  candidateCurrent CandidateProfile[] @relation("CandidateCurrentRole")
  candidateTarget  CandidateProfile[] @relation("CandidateTargetRole")
  experts          ExpertJobRole[]

  @@unique([industryId, slug])
  @@index([industryId])
  @@map("job_roles")
}

model Specialization {
  id         String                 @id @default(uuid()) @db.Uuid
  industryId String                 @map("industry_id") @db.Uuid
  name       String                 @db.VarChar(120)
  slug       String                 @db.VarChar(120)
  isActive   Boolean                @default(true) @map("is_active")
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  industry   Industry               @relation(fields: [industryId], references: [id], onDelete: Cascade)
  experts    ExpertSpecialization[]

  @@unique([industryId, slug])
  @@index([industryId])
  @@map("specializations")
}

model InterviewType {
  id        String                @id @default(uuid()) @db.Uuid
  name      String                @db.VarChar(120)
  slug      String                @unique @db.VarChar(120)
  isActive  Boolean               @default(true) @map("is_active")
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  experts   ExpertInterviewType[]

  @@map("interview_types")
}

model ExperienceLevel {
  id         String                 @id @default(uuid()) @db.Uuid
  name       String                 @db.VarChar(120)
  sortOrder  Int                    @default(0) @map("sort_order")
  isActive   Boolean                @default(true) @map("is_active")
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  candidates CandidateProfile[]     @relation("CandidateTargetLevel")
  experts    ExpertCandidateLevel[]

  @@map("experience_levels")
}

model CandidateProfile {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String                 @unique @map("user_id") @db.Uuid
  careerStage            CareerStage?           @map("career_stage")
  industryId             String?                @map("industry_id") @db.Uuid
  currentRoleId          String?                @map("current_role_id") @db.Uuid
  targetRoleId           String?                @map("target_role_id") @db.Uuid
  yearsExperience        Int?                   @map("years_experience")
  targetLevelId          String?                @map("target_level_id") @db.Uuid
  goals                  String[]               @default([])
  profileCompletionState ProfileCompletionState @default(INCOMPLETE) @map("profile_completion_state")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry               Industry?              @relation("CandidateIndustry", fields: [industryId], references: [id], onDelete: SetNull)
  currentRole            JobRole?               @relation("CandidateCurrentRole", fields: [currentRoleId], references: [id], onDelete: SetNull)
  targetRole             JobRole?               @relation("CandidateTargetRole", fields: [targetRoleId], references: [id], onDelete: SetNull)
  targetLevel            ExperienceLevel?       @relation("CandidateTargetLevel", fields: [targetLevelId], references: [id], onDelete: SetNull)

  @@index([industryId])
  @@map("candidate_profiles")
}

model ExpertProfile {
  id                     String                        @id @default(uuid()) @db.Uuid
  userId                 String                        @unique @map("user_id") @db.Uuid
  professionalHeadline   String?                       @map("professional_headline") @db.VarChar(150)
  currentDesignation     String?                       @map("current_designation") @db.VarChar(150)
  currentCompany         String?                       @map("current_company") @db.VarChar(150)
  countryCode            String?                       @map("country_code") @db.VarChar(2)
  timezone               String?                       @db.VarChar(64)
  linkedinUrl            String?                       @map("linkedin_url") @db.VarChar(2048)
  introduction           String?                       @db.Text
  yearsExperience        Int?                          @map("years_experience")
  verificationStatus     VerificationStatus            @default(DRAFT) @map("verification_status")
  publicationStatus      PublicationStatus             @default(UNPUBLISHED) @map("publication_status")
  reviewedById           String?                       @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime?                     @map("reviewed_at") @db.Timestamptz(3)
  reviewNotes            String?                       @map("review_notes") @db.Text
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                   User                          @relation("ExpertProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy             User?                         @relation("ExpertProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  experiences            ExpertExperience[]
  industries             ExpertIndustry[]
  specializations        ExpertSpecialization[]
  interviewTypes         ExpertInterviewType[]
  jobRoles               ExpertJobRole[]
  candidateLevels        ExpertCandidateLevel[]
  languages              ExpertLanguage[]
  availabilityRules      ExpertAvailabilityRule[]
  availabilityExceptions ExpertAvailabilityException[]
  slotReservations       SlotReservation[]
  bookings               Booking[]

  @@index([verificationStatus, publicationStatus])
  @@map("expert_profiles")
}

model ExpertExperience {
  id              String        @id @default(uuid()) @db.Uuid
  expertProfileId String        @map("expert_profile_id") @db.Uuid
  company         String        @db.VarChar(150)
  designation     String        @db.VarChar(150)
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  description     String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  @@index([expertProfileId])
  @@map("expert_experiences")
}

model ExpertIndustry {
  id              String        @id @default(uuid()) @db.Uuid
  expertProfileId String        @map("expert_profile_id") @db.Uuid
  industryId      String        @map("industry_id") @db.Uuid
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  industry        Industry      @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([expertProfileId, industryId])
  @@map("expert_industries")
}

model ExpertSpecialization {
  id               String         @id @default(uuid()) @db.Uuid
  expertProfileId  String         @map("expert_profile_id") @db.Uuid
  specializationId String         @map("specialization_id") @db.Uuid
  expertProfile    ExpertProfile  @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@unique([expertProfileId, specializationId])
  @@map("expert_specializations")
}

model ExpertInterviewType {
  id              String        @id @default(uuid()) @db.Uuid
  expertProfileId String        @map("expert_profile_id") @db.Uuid
  interviewTypeId String        @map("interview_type_id") @db.Uuid
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  interviewType   InterviewType @relation(fields: [interviewTypeId], references: [id], onDelete: Cascade)

  @@unique([expertProfileId, interviewTypeId])
  @@map("expert_interview_types")
}

model ExpertJobRole {
  id              String        @id @default(uuid()) @db.Uuid
  expertProfileId String        @map("expert_profile_id") @db.Uuid
  jobRoleId       String        @map("job_role_id") @db.Uuid
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  jobRole         JobRole       @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@unique([expertProfileId, jobRoleId])
  @@map("expert_job_roles")
}

model ExpertCandidateLevel {
  id                String          @id @default(uuid()) @db.Uuid
  expertProfileId   String          @map("expert_profile_id") @db.Uuid
  experienceLevelId String          @map("experience_level_id") @db.Uuid
  expertProfile     ExpertProfile   @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  experienceLevel   ExperienceLevel @relation(fields: [experienceLevelId], references: [id], onDelete: Cascade)

  @@unique([expertProfileId, experienceLevelId])
  @@map("expert_candidate_levels")
}

model ExpertLanguage {
  id              String        @id @default(uuid()) @db.Uuid
  expertProfileId String        @map("expert_profile_id") @db.Uuid
  languageCode    String        @map("language_code") @db.VarChar(16)
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  @@unique([expertProfileId, languageCode])
  @@map("expert_languages")
}

enum AvailabilityExceptionType {
  UNAVAILABLE
}

enum SlotReservationStatus {
  HELD
  CONSUMED
  RELEASED
  EXPIRED
}

/// Recurring weekly availability window in the expert's local time. Weekday
/// uses ISO numbering: 1 = Monday through 7 = Sunday.
model ExpertAvailabilityRule {
  id                  String        @id @default(uuid()) @db.Uuid
  expertProfileId     String        @map("expert_profile_id") @db.Uuid
  weekday             Int
  startLocalTime      String        @map("start_local_time") @db.VarChar(5)
  endLocalTime        String        @map("end_local_time") @db.VarChar(5)
  timezone            String        @db.VarChar(64)
  slotDurationMinutes Int           @map("slot_duration_minutes")
  effectiveFrom       DateTime      @map("effective_from") @db.Date
  effectiveUntil      DateTime?     @map("effective_until") @db.Date
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  expertProfile       ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  @@index([expertProfileId, weekday])
  @@map("expert_availability_rules")
}

/// A period when the expert is unavailable, stored as UTC instants. Full-day
/// exceptions are converted from the expert's timezone by the API.
model ExpertAvailabilityException {
  id              String                    @id @default(uuid()) @db.Uuid
  expertProfileId String                    @map("expert_profile_id") @db.Uuid
  startsAt        DateTime                  @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime                  @map("ends_at") @db.Timestamptz(3)
  exceptionType   AvailabilityExceptionType @default(UNAVAILABLE) @map("exception_type")
  reason          String?                   @db.VarChar(280)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  expertProfile   ExpertProfile             @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  @@index([expertProfileId, startsAt, endsAt])
  @@map("expert_availability_exceptions")
}

/// The transactional claim on a slot. Active HELD and CONSUMED reservations
/// block overlapping slots; RELEASED and EXPIRED reservations do not.
model SlotReservation {
  id              String                @id @default(uuid()) @db.Uuid
  expertProfileId String                @map("expert_profile_id") @db.Uuid
  candidateUserId String                @map("candidate_user_id") @db.Uuid
  startsAt        DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime              @map("ends_at") @db.Timestamptz(3)
  status          SlotReservationStatus @default(HELD)
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz(3)
  bookingId       String?               @unique @map("booking_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  expertProfile   ExpertProfile         @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  candidate       User                  @relation("CandidateSlotReservations", fields: [candidateUserId], references: [id], onDelete: Cascade)
  booking         Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([expertProfileId, startsAt, endsAt])
  @@index([status, expiresAt])
  @@map("slot_reservations")
}

enum BookingStatus {
  PENDING_EXPERT_APPROVAL
  APPROVED_PENDING_PAYMENT
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
  IN_PROGRESS
  COMPLETED_PENDING_FEEDBACK
  COMPLETED
}

/// A booking owns one slot reservation. Price fields remain nullable until
/// platform pricing is approved; no amount is inferred by the booking or
/// mock payment lifecycle.
model Booking {
  id                     String                 @id @default(uuid()) @db.Uuid
  candidateUserId        String                 @map("candidate_user_id") @db.Uuid
  expertProfileId        String                 @map("expert_profile_id") @db.Uuid
  startsAt               DateTime               @map("starts_at") @db.Timestamptz(3)
  endsAt                 DateTime               @map("ends_at") @db.Timestamptz(3)
  timezone               String                 @db.VarChar(64)
  durationMinutes        Int                    @map("duration_minutes")
  priceAmount            Int?                   @map("price_amount")
  currency               String?                @db.VarChar(3)
  expertPayoutAmount     Int?                   @map("expert_payout_amount")
  platformAmount         Int?                   @map("platform_amount")
  status                 BookingStatus          @default(PENDING_EXPERT_APPROVAL)
  idempotencyKey         String?                @map("idempotency_key") @db.VarChar(100)
  expertResponseDeadline DateTime               @map("expert_response_deadline") @db.Timestamptz(3)
  paymentDeadline        DateTime?              @map("payment_deadline") @db.Timestamptz(3)
  confirmedAt            DateTime?              @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt            DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  completedAt            DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  candidate              User                   @relation("BookingCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  expertProfile          ExpertProfile          @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  reservation            SlotReservation?
  history                BookingStatusHistory[]
  payments               Payment[]
  notificationEvents     NotificationEvent[]
  interviewSession       InterviewSession?

  @@unique([candidateUserId, idempotencyKey])
  @@index([candidateUserId, status])
  @@index([expertProfileId, status])
  @@index([expertResponseDeadline])
  @@index([paymentDeadline])
  @@map("bookings")
}

model BookingStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  bookingId       String         @map("booking_id") @db.Uuid
  fromStatus      BookingStatus? @map("from_status")
  toStatus        BookingStatus  @map("to_status")
  changedByUserId String?        @map("changed_by_user_id") @db.Uuid
  reason          String?        @db.VarChar(500)
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy       User?          @relation("BookingStatusActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

enum InterviewSessionProvider {
  STREAM_VIDEO
}

enum InterviewSessionStatus {
  READY
  IN_PROGRESS
  ENDED
}

/// One provider session per confirmed booking. Participant JWTs are issued by
/// the backend and are never stored; only the session lifecycle is persisted.
model InterviewSession {
  id                       String                   @id @default(uuid()) @db.Uuid
  bookingId                String                   @unique @map("booking_id") @db.Uuid
  provider                 InterviewSessionProvider @default(STREAM_VIDEO)
  providerSessionReference String                   @unique @map("provider_session_reference") @db.VarChar(200)
  status                   InterviewSessionStatus   @default(READY)
  startedAt                DateTime?                @map("started_at") @db.Timestamptz(3)
  endedAt                  DateTime?                @map("ended_at") @db.Timestamptz(3)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking                  Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("interview_sessions")
}

enum PaymentProvider {
  MOCK
  RAZORPAY
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

/// A simulated payment attempt. Amount and currency mirror the booking's
/// nullable price snapshot so no price is invented before pricing is approved.
/// Payment status is intentionally separate from booking status.
model Payment {
  id                       String          @id @default(uuid()) @db.Uuid
  bookingId                String          @map("booking_id") @db.Uuid
  provider                 PaymentProvider @default(MOCK)
  providerPaymentReference String?         @unique @map("provider_payment_reference") @db.VarChar(160)
  amount                   Int?
  currency                 String?         @db.VarChar(3)
  status                   PaymentStatus   @default(CREATED)
  idempotencyKey           String?         @map("idempotency_key") @db.VarChar(100)
  paidAt                   DateTime?       @map("paid_at") @db.Timestamptz(3)
  failureReason            String?         @map("failure_reason") @db.VarChar(500)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking                  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, idempotencyKey])
  @@index([bookingId, status])
  @@map("payments")
}

enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_APPROVED
  BOOKING_DECLINED
  PAYMENT_DEADLINE_REMINDER
  BOOKING_CONFIRMED
  BOOKING_EXPIRED
  INTERVIEW_REMINDER
}

enum NotificationEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum NotificationChannel {
  IN_APP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// Transactional outbox for business events. Booking and payment operations
/// only write here; recipient notifications and delivery attempts run later.
model NotificationEvent {
  id            String                  @id @default(uuid()) @db.Uuid
  dedupeKey     String                  @unique @map("dedupe_key") @db.VarChar(160)
  type          NotificationType
  bookingId     String?                 @map("booking_id") @db.Uuid
  data          Json?
  status        NotificationEventStatus @default(PENDING)
  attempts      Int                     @default(0)
  lastError     String?                 @map("last_error") @db.Text
  availableAt   DateTime                @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt   DateTime?               @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  booking       Booking?                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([status, availableAt])
  @@index([bookingId])
  @@map("notification_events")
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  eventId    String                 @map("event_id") @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  type       NotificationType
  title      String                 @db.VarChar(160)
  body       String                 @db.Text
  data       Json?
  readAt     DateTime?              @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  event      NotificationEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([eventId, userId])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        NotificationChannel        @default(IN_APP)
  status         NotificationDeliveryStatus @default(PENDING)
  attemptCount   Int                        @default(0) @map("attempt_count")
  lastError      String?                    @map("last_error") @db.Text
  sentAt         DateTime?                  @map("sent_at") @db.Timestamptz(3)
  nextAttemptAt  DateTime?                  @map("next_attempt_at") @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}
