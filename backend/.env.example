# Backend environment template
# Copy to .env for local development. Never commit .env.
# Zoom, storage, email, and payment secrets are backend-only and must never
# be exposed through NEXT_PUBLIC_ variables.

# Database
DATABASE_URL=

# Authentication
AUTH_SECRET=

# Application
API_URL=

# Zoom (backend only)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email
RESEND_API_KEY=

# Storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Payments — mock provider only for the MVP
PAYMENT_PROVIDER=mock
# Future gateway; do not enable without approval
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
