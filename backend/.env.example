# Backend environment template
# Copy to .env for local development. Never commit .env.
# Stream, storage, email, and payment secrets are backend-only and must never
# be exposed through NEXT_PUBLIC_ variables.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Local development uses the embedded PostgreSQL started by `npm run db:start`.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/mockoraa?schema=public

# Sessions
SESSION_COOKIE_NAME=mockoraa_session
SESSION_TTL_DAYS=30
# Set to true when serving over HTTPS; production always uses secure cookies.
SESSION_COOKIE_SECURE=false

# Initial administrator seed (`npm run seed:admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Mockoraa Admin

# Database (hosted environments)
# DATABASE_URL=

# Authentication
# AUTH_SECRET=

# Application
# API_URL=

# Stream Video (backend only). Never expose the API secret to the browser.
# The API key is returned to participants with their short-lived user token.
# STREAM_API_KEY=
# STREAM_API_SECRET=
# STREAM_CALL_TYPE=default

# Interview join window. These provisional defaults are configurable because the
# final late-join policy is still an open product decision.
INTERVIEW_JOIN_EARLY_MINUTES=15
INTERVIEW_JOIN_CLOSE_GRACE_MINUTES=15

# Email
# RESEND_API_KEY=

# Storage
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=

# Payments — mock provider only for the MVP
PAYMENT_PROVIDER=mock
# Future gateway; do not enable without approval
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
